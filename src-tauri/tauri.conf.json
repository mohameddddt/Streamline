{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamline",
  "version": "0.5.0",
  "identifier": "com.streamline.app",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:ui && npm run ffmpeg",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Streamline",
        "width": 1360,
        "height": 860,
        "minWidth": 940,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#0b0c0f",
        "dragDropEnabled": false,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "mohamedddt",
    "category": "Video",
    "shortDescription": "Movie & TV streamer",
    "icon": ["../resources/icon.png", "../resources/icon.ico"],
    "resources": { "resources/ffmpeg/": "ffmpeg/" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
