{
  "name": "streamline",
  "version": "0.5.0",
  "description": "Movie & TV streamer for desktop (Rust + Tauri) and the web, powered by Stremio-compatible addons (Torrentio, TorrentsDB, ...)",
  "author": "mohamedddt",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:ui": "vite --config vite.desktop.config.ts",
    "build:ui": "vite build --config vite.desktop.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "ffmpeg": "node scripts/prepare-ffmpeg.cjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "icon": "node scripts/make-icon.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "ffmpeg-static": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohameddddt/Streamline.git"
  }
}
